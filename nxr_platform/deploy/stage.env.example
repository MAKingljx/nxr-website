# Copy to /etc/nxr-java/stage.env with mode 0600. Never commit real values.
SPRING_PROFILES_ACTIVE=druid,prod

NXR_SERVER_ADDRESS=127.0.0.1
# Overridden by /etc/nxr-java/slots/<slot>.env during blue/green deployment.
NXR_SERVER_PORT=18088
NXR_TOMCAT_ACCEPT_COUNT=50
NXR_TOMCAT_MAX_THREADS=40
NXR_TOMCAT_MIN_SPARE_THREADS=4

NXR_DB_URL=jdbc:mysql://127.0.0.1:3306/nxr_java_stage?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=GMT%2B8
NXR_DB_USERNAME=nxr_java_stage
NXR_DB_PASSWORD=__REQUIRED_RANDOM_SECRET__

NXR_REDIS_HOST=127.0.0.1
NXR_REDIS_PORT=16379
NXR_REDIS_DATABASE=0
NXR_REDIS_PASSWORD=__REQUIRED_RANDOM_SECRET__

NXR_TOKEN_SECRET=__REQUIRED_RANDOM_SECRET_AT_LEAST_64_CHARACTERS__
# Add https://nxrgrading.com when the optional HTTPS stage paths are enabled.
NXR_CORS_ALLOWED_ORIGINS=http://127.0.0.1:18080,http://127.0.0.1:18081
NXR_MEDIA_STORAGE_ROOT=/var/lib/nxr-java/media
NXR_LEGACY_PYTHON_UPLOAD_ROOT=/var/lib/nxr-java/python-uploads
# Use https://nxrgrading.com/java-stage for the optional HTTPS deployment.
NXR_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:18080
NXR_EXPORTS_STORAGE_ROOT=/var/lib/nxr-java/exports
# Use https://nxrgrading.com/java-stage for the optional HTTPS deployment.
NXR_PUBLIC_SITE_BASE_URL=http://127.0.0.1:18080
# Overridden by /etc/nxr-java/slots/<slot>.env during blue/green deployment.
NXR_LOG_PATH=/var/log/nxr-java/blue
NXR_PAYMENT_CALLBACK_TOKEN=

# Optional feature providers. With blank values the site keeps working: AI
# uses a local safe summary and waitlist signups are stored without sending email.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
NXR_RESEND_KEY=
NXR_EMAIL_FROM=
# SMTP is used only when Resend is unavailable or fails.
NXR_SMTP_HOST=
NXR_SMTP_PORT=587
NXR_SMTP_USER=
NXR_SMTP_PASS=
NXR_SMTP_STARTTLS=true

NXR_DRUID_WEB_STATS_ENABLED=false
NXR_DRUID_CONSOLE_ENABLED=false
NXR_DRUID_CONSOLE_ALLOW=127.0.0.1
NXR_DRUID_CONSOLE_USERNAME=__REQUIRED_WHEN_CONSOLE_ENABLED__
NXR_DRUID_CONSOLE_PASSWORD=__REQUIRED_RANDOM_SECRET_WHEN_CONSOLE_ENABLED__
