# Copy outside the source checkout and chmod 0600. No shell interpolation occurs.
NXR_BACKUP_SOURCE_DATABASE=nxr_java_stage_sync_20260804
NXR_BACKUP_MYSQL_SOCKET=/var/run/mysqld/mysqld.sock
NXR_BACKUP_MYSQL_USER=root
# Optional native-client credentials file must also be mode 0600.
NXR_BACKUP_MYSQL_DEFAULTS_FILE=
NXR_BACKUP_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
NXR_BACKUP_R2_ACCESS_KEY_ID=
NXR_BACKUP_R2_SECRET_ACCESS_KEY=
NXR_BACKUP_R2_BUCKET=nxr-private-database-backups
NXR_BACKUP_IMAGE_BUCKET=REPLACE_WITH_EXISTING_CARD_BUCKET
# Public age X25519 recipient only. Never put a recovery identity on this server.
NXR_BACKUP_AGE_RECIPIENT=
# Set only after confirming the backup bucket has no public domain/R2.dev access.
NXR_BACKUP_PRIVATE_BUCKET_CONFIRMED=0
NXR_BACKUP_WORK_ROOT=/var/lib/nxr-mysql-r2-backup/work
NXR_BACKUP_STATE_ROOT=/var/lib/nxr-mysql-r2-backup/state
NXR_BACKUP_RETENTION=2
# Explicit authorization for creating/dropping disposable verification schemas.
NXR_BACKUP_ALLOW_ISOLATED_RESTORE=0
NXR_BACKUP_PROCESS_TIMEOUT=3600
