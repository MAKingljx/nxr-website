server {
    listen 127.0.0.1:18083;
    server_name localhost;
    root @@NXR_RELEASE_ROOT@@/admin-remote;
    index index.html;
    client_max_body_size 256M;

    add_header X-Robots-Tag "noindex, nofollow" always;

