# Copy to /etc/nxr-java/python-sync.env with mode 0600.
# Keep both values identical; the duplicate is an intentional target guard.
NXR_SYNC_TARGET_DATABASE=nxr_java_stage_migrated_YYYYMMDD
NXR_SYNC_CONFIRM_TARGET_DATABASE=nxr_java_stage_migrated_YYYYMMDD
NXR_SYNC_MYSQL_USER=nxr_python_sync
NXR_SYNC_MYSQL_PASSWORD=__REQUIRED_RANDOM_SECRET__
