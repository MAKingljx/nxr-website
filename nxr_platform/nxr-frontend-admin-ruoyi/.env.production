# 页面标题
VITE_APP_TITLE = NXR Grading Admin

# 生产环境配置
VITE_APP_ENV = 'production'

# NXR 管理系统/生产环境（Nginx 将该前缀代理到 127.0.0.1:8088）
VITE_APP_BASE_API = '/prod-api'

# Existing Python production admin path. Java stage overrides this to root.
VITE_APP_BASE_PATH = '/x7k9m2q4r8v6c3p1/'

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS = gzip
