{
  "name": "nxr-photo-renamer",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:ocr-assets": "node scripts/copy-tesseract-assets.mjs",
    "predev": "npm run prepare:ocr-assets",
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "prebuild": "npm run prepare:ocr-assets",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "desktop": "npm run build && electron .",
    "test:desktop": "node --import tsx scripts/test-desktop.mjs",
    "test:corpus": "node --import tsx scripts/test-corpus.mjs",
    "verify:desktop": "npm test && npm run build && npm run test:desktop && npm run test:corpus",
    "package:verified": "npm run verify:desktop && node scripts/package-desktop.mjs",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@tesseract.js-data/eng": "1.0.0",
    "idb-keyval": "6.3.0",
    "jsqr": "1.4.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "vue": "3.5.32"
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@electron/packager": "20.3.0",
    "@playwright/test": "1.58.2",
    "@types/node": "24.12.2",
    "@types/qrcode": "1.5.5",
    "@types/wicg-file-system-access": "2023.10.7",
    "@vitejs/plugin-vue": "6.0.6",
    "electron": "44.2.0",
    "qrcode": "1.5.4",
    "tsx": "4.20.5",
    "typescript": "6.0.2",
    "vite": "8.2.2",
    "vue-tsc": "3.2.7"
  },
  "main": "desktop/main.cjs"
}
